{
    "envName": "default",
    "web": {
        "baseURL": "https://example.com",
        "timeout": 30000,
        "viewport": {
            "width": 1280,
            "height": 800
        },
        "headless": true,
        "retries": 1
    },
    "api": {
        "baseURL": "https://api.example.com/v1",
        "timeout": 15000,
        "retries": 1,
        "defaultHeaders": {
            "Accept": "application/json",
            "Content-Type": "application/json"
        }
    },
    "report": {
        "allureResultsDir": "./reports/allure-results",
        "htmlReportDir": "./reports/html-report"
    },
    "auth": {
        "username": "",
        "password": ""
    },
    "logging": {
        "level": "info"
    }
}