{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "resolveJsonModule": true,
        "allowJs": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": ".",
        "paths": {
            "@api/*": [
                "src/api/*"
            ],
            "@config/*": [
                "src/config/*"
            ],
            "@constants/*": [
                "src/constants/*"
            ],
            "@elements/*": [
                "src/elements/*"
            ],
            "@enums/*": [
                "src/enums/*"
            ],
            "@helpers/*": [
                "src/helpers/*"
            ],
            "@interfaces/*": [
                "src/interfaces/*"
            ],
            "@locators/*": [
                "src/locators/*"
            ],
            "@pages/*": [
                "src/pages/*"
            ],
            "@reports/*": [
                "src/reports/*"
            ],
            "@resources/*": [
                "src/resources/*"
            ],
            "@scripts/*": [
                "src/scripts/*"
            ],
            "@support/*": [
                "src/support/*"
            ],
            "@tests/*": [
                "src/tests/*"
            ],
            "@types/*": [
                "src/types/*"
            ],
            "@utils/*": [
                "src/utils/*"
            ]
        }
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}